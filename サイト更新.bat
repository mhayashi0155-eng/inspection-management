@echo off
chcp 65001 >nul
cd /d %~dp0

echo ========================================================
echo   サイト更新ツール（GitHub自動アップロード）
echo ========================================================
echo.
echo 現在のフォルダ: %~dp0
echo.

:: ユーザーに入力を求める
set /p msg="変更内容を簡単に入力してください (Enterのみで「サイト更新」): "

:: 入力が空ならデフォルト値を設定
if "%msg%"=="" set msg=サイト更新

echo.
echo [1/3] 変更されたファイルを集めています...
git add .

echo.
echo [2/3] "%msg%" として保存しています...
git commit -m "%msg%"

echo.
echo [3/3] GitHubへ送信しています...
git push origin main

echo.
echo ========================================================
echo   送信が完了しました！
echo   Vercelによって数分以内にサイトが更新されます。
echo ========================================================
echo.
pause
